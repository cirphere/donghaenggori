# ============================================================================
#  동행고리 AI — 프론트(frontend 컨테이너) 환경변수
# ============================================================================
#     cp .env.frontend.example .env.frontend
#
#  이미 채운 파일에 다시 cp 하지 않는다 — 채워둔 값이 날아간다.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────
#  화면 접근 제한 (nginx 기본 인증)
# ─────────────────────────────────────────────────────────────────────
#  사회복지사 콘솔은 접수 목록과 어르신 정보를 보여준다. 주소만 알면 누구나
#  들어올 수 있으면 안 된다.
#
#  둘 다 채워야 인증이 켜진다. 비워두면 **인증이 꺼진 채로 뜨고**, 기동 로그에
#  경고가 크게 남는다(조용히 열려 있는 것보다 낫다). 배포 점검에서 이 줄을 본다:
#
#      docker compose logs frontend | grep 기본 인증
#
#  전화 웹훅(/api/voice/)과 헬스체크(/api/health)는 인증에서 제외돼 있다 —
#  ClawOps 는 비밀번호를 모른다.
#
#  팀원에게 공유할 때도 이 파일을 통째로 보내지 말고 값만 따로 전달한다.
STAFF_USER=
STAFF_PASSWORD=
