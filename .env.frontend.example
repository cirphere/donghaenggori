# 프론트(frontend) 설정 —  cp .env.frontend.example .env.frontend
# 이미 채운 파일에 다시 cp 하지 말 것

# ── 콘솔 로그인 (nginx 기본 인증) ───────────────────────────────────
# 둘 다 채워야 인증이 켜진다. 비우면 인증 없이 뜨고 기동 로그에 경고가 남는다:
#     docker compose logs frontend | grep 기본 인증
# 전화 웹훅(/api/voice/)과 /api/health 는 인증에서 제외돼 있다.
STAFF_USER=
STAFF_PASSWORD=
