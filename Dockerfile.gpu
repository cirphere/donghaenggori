# syntax=docker/dockerfile:1
# 동행고리 AI — GPU(CUDA) 배포 이미지
#
# 용도: 집 데스크탑(Windows + RTX 4060 Ti)에서 Cloudflare Tunnel로 공유할 때.
# 본선 당일 발표 노트북은 CPU용 Dockerfile을 그대로 쓴다 — 이 파일은 별개다.
#
# CPU 이미지와의 차이는 두 가지뿐이다.
#   1) torch를 CUDA 12 빌드로 받는다 → CUDA 런타임(nvidia-*)이 함께 깔린다
#   2) CTranslate2가 그 라이브러리를 찾도록 ldconfig에 경로를 등록한다
# 그래서 이미지가 수 GB로 커진다. 로컬에서만 쓰므로 밀어 넣을 일이 없어 무방하다.
#
# 전제: Windows용 NVIDIA 드라이버(최신). WSL 안에 리눅스 드라이버를 깔면 깨진다.
#       Docker Desktop(WSL2 백엔드)이면 nvidia-container-toolkit이 불필요하고,
#       WSL 안에 Docker 엔진을 직접 깔았으면 toolkit을 설치해야 한다(README 참조).

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# torch를 CUDA 12 빌드로 고정한다.
#
# 기본 인덱스의 torch(2.13)는 CUDA 13을 가져와 libcublas.so.13 을 깐다.
# 그런데 CTranslate2 4.8(faster-whisper)은 CUDA 12 빌드라 libcublas.so.12 를
# 찾는다. 그대로 두면 전사할 때 이렇게 죽는다:
#     RuntimeError: Library libcublas.so.12 is not found or cannot be loaded
#
# nvidia-cublas-cu12 를 따로 얹는 방법도 있으나, cuDNN 이 torch 것과 같은
# 디렉터리·같은 SONAME(libcudnn.so.9)이라 서로 덮어써 torch가 깨질 수 있다.
# CUDA 버전을 하나로 맞추는 편이 안전하다.
#
# **requirements.txt 를 복사하기 전에** 깐다. 전에는 COPY 가 앞에 있어서,
# torch 와 아무 상관 없는 의존성 한 줄만 고쳐도 같은 레이어에 묶인 CUDA torch 를
# 통째로 다시 받았다(5GB 안팎). 이 순서면 torch 레이어는 베이스 이미지에만
# 의존한다.
#
# 캐시 마운트를 쓰는 이유: --no-cache-dir 은 레이어가 한 번 깨지면 무조건
# 네트워크에서 다시 받는다. 빌드 캐시가 정리되거나(WSL 디스크가 차면 제일 큰
# 이 레이어부터 날아간다), 베이스 이미지 다이제스트가 바뀌거나, 빌드가 중간에
# 죽으면 매번 재다운로드다. 캐시 마운트는 **이미지에 들어가지 않으므로**
# 이미지 크기는 그대로다.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --index-url https://download.pytorch.org/whl/cu126 torch

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY donghaenggori ./donghaenggori
COPY tests ./tests
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# faster-whisper(CTranslate2)는 torch가 끌어온 cuBLAS·cuDNN을 직접 dlopen 한다.
# 경로를 잡아주지 않으면 "libcublas.so.12 is not found" 로 죽는다.
#
# 디렉터리 구조는 torch 버전마다 바뀐다 — cu12 계열은 nvidia/cublas/lib,
# cu13 계열은 nvidia/cu13/lib 로 합쳐진다. 하드코딩하면 조용히 어긋나므로
# 빌드 시점에 실제 위치를 찾아 ldconfig 에 등록한다.
RUN python -c "import pathlib; r=pathlib.Path('/usr/local/lib/python3.12/site-packages/nvidia'); print('\n'.join(sorted({str(p.parent) for p in r.rglob('*.so*')})))" \
      > /etc/ld.so.conf.d/nvidia.conf \
    && ldconfig

# 빌드 시점에 확인한다. 여기서 걸러야 시연 중에 전사가 죽는 걸 막는다.
RUN ldconfig -p | grep -q 'libcublas\.so\.12' \
    || { echo 'ERROR: libcublas.so.12 없음 — torch가 CUDA 12 빌드가 아닙니다'; exit 1; }

ENV HF_HOME=/models/hf \
    DONGHAENGGORI_DB=/data/donghaenggori.db \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN useradd -m -u 10001 app \
    && mkdir -p /models/hf /data \
    && chown -R app:app /app /models /data
USER app

EXPOSE 8000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["uvicorn", "donghaenggori.web.api:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
