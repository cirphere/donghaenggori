# 백엔드(app) 설정 —  cp .env.app.example .env.app
# 이미 채운 파일에 다시 cp 하지 말 것 (키가 날아간다)
# 전부 없어도 동작한다. 없으면 규칙 기반·미연동으로 폴백.

# ── 공공데이터포털 (심평원·기상청·에어코리아 공용) ──────────────────
# 반드시 '일반 인증키(Decoding)'. Encoding 키가 아니다.
DATA_GO_KR_KEY=
PUBLIC_API_TIMEOUT=12.0          # 심평원이 느리다(실측 8초). 짧으면 항상 타임아웃
PUBLIC_API_CACHE_TTL=600

# ── Claude API (기본 꺼둠) ──────────────────────────────────────────
# 채우면 자동으로 켜지고, 어르신 발화가 외부로 나간다.
# 적용 여부는 기동 로그 "AI 배치 —" 줄에서 확인.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT=

# ── 음성인식 (로컬, 키 불필요) ──────────────────────────────────────
# GPU 오버레이를 쓰면 그쪽 값(medium/cuda)이 이긴다.
WHISPER_MODEL=base               # vCPU 2개 기준. small 은 3배 느리다
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=            # 비우면 cuda→float16, cpu→int8
WHISPER_CPU_THREADS=2
STT_CONF_THRESHOLD=-0.9          # 낮으면 접수에 '사람 확인 필요'
STT_MAX_SECONDS=300              # 넘으면 413. 없으면 긴 파일 하나로 OOM
HF_TOKEN=                        # 모델 다운로드 속도 제한 풀 때만

# ── 웹 ──────────────────────────────────────────────────────────────
CORS_ORIGINS=                    # 비우면 전부 허용

# ── 전화 연동 (ClawOps) ─────────────────────────────────────────────
# ClawOps 대시보드의 Webhook Signing Secret. API Key 가 아니다.
# 비면 /api/voice/* 가 503 (전화 꺼짐).
CLAWOPS_SIGNING_KEY=
CLAWOPS_STAFF_NUMBER=            # 긴급 시 연결할 담당자. 없으면 안내만

CLAWOPS_IDENTITY_SECONDS=        # 성함 녹음 상한. 비우면 20
CLAWOPS_MAX_RECORD_SECONDS=      # 문의 녹음 상한. 비우면 60
                                 # 적으면 코드 기본값을 덮어쓴다 — 기동 로그로 확인
CLAWOPS_GREETING=                # 비우면 코드 기본 인사말
CLAWOPS_FINISH_ON_KEY=1234567890*#
CLAWOPS_ASK_IDENTITY=1           # 0 이면 이름 확인 질문(1번/2번) 없이 바로 문의

# 시연 전용 — 발표자 번호를 등록 대상자로 바꿔 조회한다(본인확인 아님).
# 둘 다 채워야 동작. 비우면 미등록으로 처리돼 이름 확인 질문이 안 나온다.
DEMO_CALLER_PHONE=
DEMO_CALLER_TARGET=010-1234-5678

# 전화 콜백 주소를 만들 때 쓴다. 프록시 뒤에서는 직접 적어야 확실하다.
PUBLIC_BASE_URL=https://donghaenggori.dohyeongops.com
