# 백엔드(app) 설정. 전부 없어도 동작한다 — 없으면 규칙 기반·미연동으로 폴백.
# 값을 넣을 땐 맨 앞 # 을 지운다.

# ── 공공데이터포털 (심평원·기상청·에어코리아 공용) ──────────────────
# 반드시 '일반 인증키(Decoding)'. Encoding 키가 아니다.
#DATA_GO_KR_KEY=
# 심평원이 느리다(실측 8초). 짧으면 항상 타임아웃
PUBLIC_API_TIMEOUT=12.0
PUBLIC_API_CACHE_TTL=600

# ── Claude API (기본 꺼둠) ──────────────────────────────────────────
# 채우면 자동으로 켜지고, 어르신 발화가 외부로 나간다.
# 적용 여부는 기동 로그 "AI 배치 —" 줄에서 확인.
#ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
#ANTHROPIC_TIMEOUT=

# ── 음성인식 (로컬, 키 불필요) ──────────────────────────────────────
# GPU 오버레이를 쓰면 그쪽 값(medium/cuda)이 이긴다.
# base: vCPU 2개 기준. small 은 같은 장비에서 3배 느리다.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# 비우면 device 에 따라 정해진다 (cuda→float16, cpu→int8)
#WHISPER_COMPUTE_TYPE=
WHISPER_CPU_THREADS=2
# 전사 확신도가 이보다 낮으면 접수에 '사람 확인 필요'
STT_CONF_THRESHOLD=-0.9
# 넘으면 413. 없으면 긴 파일 하나로 OOM
STT_MAX_SECONDS=300
# 모델 다운로드 속도 제한을 풀 때만. 없어도 받아진다
#HF_TOKEN=

# ── 접수 규칙 ───────────────────────────────────────────────────────
# 확인 필요가 하나라도 남으면 접수 확정을 아예 막는다.
# 끄면(기본) 사회복지사가 사유를 달고 넘어갈 수 있고, 그 사실이 감사 로그에
# '미확인 확정' 으로 남는다. 어르신이 전화를 끊어 더 못 묻는 경우가 있어서
# 기본은 꺼 둔다. 기관 규칙으로 강제하려면 true.
INTAKE_BLOCK_ALL_UNCONFIRMED=false

# ── 인증 ────────────────────────────────────────────────────────────
# 로그인 세션 유효기간(초). 비우면 43200(12시간).
#SESSION_TTL_SECONDS=43200

# ── 웹 ──────────────────────────────────────────────────────────────
# 비우면 전부 허용. 좁히려면 프론트 주소(쉼표로 여러 개)
#CORS_ORIGINS=

# ── 전화 연동 (ClawOps) ─────────────────────────────────────────────
# ClawOps 대시보드의 Webhook Signing Secret. API Key 가 아니다.
# 비면 /api/voice/* 가 503 (전화 꺼짐).
#CLAWOPS_SIGNING_KEY=
# 긴급 시 연결할 담당자 번호. 없으면 전환하지 않고 안내만 한다.
#CLAWOPS_STAFF_NUMBER=

# 성함 녹음 상한(초). 비우면 20
#CLAWOPS_IDENTITY_SECONDS=
# 문의 녹음 상한(초). 비우면 60.
# 적으면 코드 기본값을 덮어쓴다 — 기동 로그 "전화 설정 —" 줄로 확인.
#CLAWOPS_MAX_RECORD_SECONDS=

# 통화 중 후속질문 — 확인 필요로 남은 칸을 어르신이 아직 통화 중일 때 되묻는다.
# 동행 정보의 기본 다섯(병원·방문일·방문시각·진료과·대상자)을 한 번에 하나씩,
# 최대 4회까지 되묻는다(상한 5).
#
# **0 으로 두면 꺼진다.** 실통화에서 질문이 안 들리거나 응답이 늦으면 이 한 줄로
# 끄고 재시작한다 — 없어도 접수는 지금까지처럼 그대로 만들어진다.
#CLAWOPS_FOLLOWUP_MAX=4
# 후속답변 녹음 상한(초). 요청 내용(60초)보다 짧게 둔다 — 되묻는 말의 답은
# "오후요" 한 마디이고, 키를 못 누르는 어르신에게는 이 값이 곧 침묵의 길이다.
#CLAWOPS_FOLLOWUP_SECONDS=15
# 비우면 코드 기본 인사말. 종료 방법 안내가 없으면 자동으로 붙는다.
#CLAWOPS_GREETING=
CLAWOPS_FINISH_ON_KEY=1234567890*#

# 안내 음성. 비우면 무료 기본 음성(요금 없음).
# "cartesia" 또는 "cartesia:<음성 ID>" 를 넣으면 고품질 음성이고 글자수 요금이 붙는다.
# 평소엔 비워 두고 시연 때만 켠다 — 문제가 생기면 다시 비우고 재시작하면 원복된다.
# 적용 여부는 기동 로그 "전화 설정 —" 줄의 '안내음성' 에서 확인.
#   Taehyun  cartesia:e1717dc3-b87b-4720-aa7f-b6db290e0609  (남성·따뜻)
#   Jaewon   cartesia:89f4372f-1f73-4b85-8e1e-5d24ed8bc826  (남성·차분)
#   Hyerin   cartesia:90dba946-774b-40ed-98d9-ac3835117827  (여성·편안)
#CLAWOPS_VOICE=

# 시연 전용 — 발표자 번호를 등록 대상자로 바꿔 조회한다(본인확인 아님).
# 둘 다 채워야 동작. 비우면 미등록으로 처리돼 성함·읍면동부터 묻는다.
#DEMO_CALLER_PHONE=
DEMO_CALLER_TARGET=010-1234-5678

# 전화 콜백 주소를 만들 때 쓴다. 프록시 뒤에서는 직접 적어야 확실하다.
PUBLIC_BASE_URL=https://donghaenggori.dohyeongops.com

# ── 데모 로그인 계정 ──────────────────────────────────────────────
# 시드(`python -m donghaenggori.services.seed`)가 만드는 계정의 비밀번호다.
# **소스에 적지 않는다** — 배포본이 인터넷에 열려 있어 소스에 박힌 값은
# 주소만 알면 누구나 칠 수 있는 값이 된다.
#
# 비워 두면: 없는 계정은 난수로 만들어 시드 출력에 한 번 찍고, 이미 있는
# 계정은 건드리지 않는다(재시드가 바꿔 둔 비밀번호를 덮지 않게).
#SEED_PASSWORD_TEST1=
#SEED_PASSWORD_TEST2=
#SEED_PASSWORD_ADMIN=

# ── 통화 표본 보관 (STT 개선용) ────────────────────────────────
# 켜면 통화 녹음과 전사가 짝으로 남는다. **기본은 꺼져 있다.**
#
# 남기지 않는 것이 원래 설계다 — 접수로 이어지지 못한 통화의 신상 발화가
# 쌓이지 않게 하려는 것이다. 그 대신 STT 를 개선할 방법이 없어진다:
# 무엇을 틀리는지 재려면 (음성, 정답) 쌍이 필요한데 전사 직후 지우면
# 하루를 써도 한 건도 안 남는다.
#
# 켜기 전 전제 둘(녹음 고지·보관 기간)은 이제 코드가 지킨다 —
# 켜면 첫 안내에 고지 문장이 자동으로 붙고(등록·미등록 양쪽 경로),
# 보관 기간이 지난 표본은 새로 쌓을 때 함께 지워진다.
#VOICE_KEEP_SAMPLES=1
#VOICE_SAMPLE_DIR=
# 보관 기간(일). 기본 30. 0 이하면 안 지운다 — 기관이 별도 규정을 가질 때만.
#VOICE_SAMPLE_RETENTION_DAYS=30
# 녹음 고지 문구. 비우면 기본 문장을 쓴다.
#CLAWOPS_RECORDING_NOTICE=
