# ============================================================================
#  동행고리 AI — 백엔드(app 컨테이너) 환경변수
# ============================================================================
#     cp .env.app.example .env.app      # 복사한 뒤 .env.app 에만 실제 값을 채운다
#
#  · .env.app 은 .gitignore 에 있어 커밋되지 않는다.
#  · 키를 채팅·문서·슬랙에 붙여넣지 않는다.
#  · 아래 값은 전부 "없어도 동작"한다. 없으면 규칙 기반·미연동으로 폴백한다
#    (발표 때 키 문제로 시연이 막히지 않게 한 설계).
#
#  이미 채운 파일에 다시 cp 하지 않는다 — 채워둔 키가 날아간다.
#  현재 상태:  curl localhost:8000/api/status
# ============================================================================


# ─────────────────────────────────────────────────────────────────────
#  1. 공공데이터포털  (data.go.kr)
# ─────────────────────────────────────────────────────────────────────
#  계정당 인증키 1개로 아래 3개 API를 모두 쓴다.
#  data.go.kr 로그인 → 각 API '활용신청' → 승인(1~3일) → 마이페이지에서 키 확인
#
#    · 건강보험심사평가원 병원정보서비스      → 병원 후보 보강, 진료과·진료시간
#    · 기상청 단기예보 조회서비스             → 외출 전 체크리스트(폭염·한파)
#    · 한국환경공단 에어코리아 대기오염정보    → 외출 전 체크리스트(미세먼지)
#
#  ※ 포털에서 주는 '일반 인증키(Decoding)' 를 넣는다. Encoding 키가 아니다.
#  없으면: 심평원·기상·대기 미연동. 병원 후보는 과거 동행 이력만으로 만든다.
DATA_GO_KR_KEY=

# 외부 API 타임아웃(초). 심평원은 응답이 느리다(실측 https 8초).
# 짧게 두면 항상 타임아웃된다. 캐시가 있어 시연 중 재호출은 즉시 응답한다.
PUBLIC_API_TIMEOUT=12.0
# 동일 요청 캐시 유지 시간(초). 반복 호출로 쿼터를 쓰지 않게 한다.
PUBLIC_API_CACHE_TTL=600


# ─────────────────────────────────────────────────────────────────────
#  2. Claude API  (선택 — 기본은 꺼둔다)
# ─────────────────────────────────────────────────────────────────────
#  키를 채우면 발화 이해 보강이 **자동으로 켜진다.** 그러면 어르신의 건강
#  발화가 외부로 나간다. "음성인식과 긴급 판단을 전량 자체 GPU에서 처리한다"
#  가 심사에서 내세우는 논리라, 기본은 비워 둔다(docs/심사대응.md 6번).
#
#  켜져 있어도 긴급 발화는 LLM을 타지 않는다 — 사람 연결까지의 시간이 우선.
#  적용 여부는 기동 로그의 "AI 배치 —" 줄에서 확인한다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT=


# ─────────────────────────────────────────────────────────────────────
#  3. 음성인식 (STT) — 로컬 추론, API 키 불필요
# ─────────────────────────────────────────────────────────────────────
#  compose 의 environment 가 아니라 여기서 정한다. GPU 오버레이
#  (docker-compose.gpu.yml)를 쓰면 그쪽 값이 이긴다 — medium/cuda 로 고정된다.
#
#  base: vCPU 2개 장비 기준. small 은 같은 장비에서 3배 느리다.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# 비우면 device 에 따라 정해진다(cuda→float16, cpu→int8)
WHISPER_COMPUTE_TYPE=
WHISPER_CPU_THREADS=2
# 전사 확신도가 이보다 낮으면 접수에 '사람 확인 필요' 를 붙인다
STT_CONF_THRESHOLD=-0.9
# 이보다 긴 음성은 413 으로 거절한다. 없으면 긴 파일 하나로 OOM 이 난다
# (메모리가 음성 길이에 비례해 늘어난다)
STT_MAX_SECONDS=300
# 허깅페이스 모델 다운로드 속도 제한을 풀 때만. 없어도 받아진다
HF_TOKEN=


# ─────────────────────────────────────────────────────────────────────
#  4. 웹 (CORS)
# ─────────────────────────────────────────────────────────────────────
#  프론트와 백엔드가 다른 주소라 브라우저에서 CORS 가 필요하다.
#  비우면 전부 허용. 좁히려면 프론트 주소를 적는다(쉼표로 여러 개).
CORS_ORIGINS=


# ─────────────────────────────────────────────────────────────────────
#  5. 전화 연동  (ClawOps)
# ─────────────────────────────────────────────────────────────────────
#  ClawOps 대시보드 → 웹훅 설정 → **Webhook Signing Secret**.
#  API Key 가 아니다 — 한 번 잘못 넣어서 401 로 한참 헤맸다.
#  비어 있으면 /api/voice/* 가 503 을 돌려주고 전화 연동이 꺼진 상태가 된다.
CLAWOPS_SIGNING_KEY=
# 긴급 감지 시 연결할 담당자 번호. 없으면 전환하지 않고 안내만 한다.
CLAWOPS_STAFF_NUMBER=

# 성함·읍면동만 받는 앞 단계 녹음의 상한(초). 비우면 20.
# "이영희요, 목포시 용당동" 이면 끝이라 문의 녹음만큼 길 이유가 없다.
CLAWOPS_IDENTITY_SECONDS=

# 문의 녹음 상한(초). 비우면 60.
#
# 어르신이 말을 마치고 아무 번호나 누르면 그 자리에서 끝나므로, 보통
# '대기 시간' 이 아니라 '천천히 말해도 되는 여유' 다. 짧게 잡으면 병원 이름을
# 떠올리는 사이에 말이 잘린다.
#
# **여기에 값을 적으면 코드 기본값을 덮어쓴다.** 예전 배포본에 30 이 적혀
# 있어서, 코드에서 60 으로 늘려도 실제 통화는 30 초에서 잘렸다.
# 기동 로그의 "전화 설정 —" 줄에서 실제 적용값을 확인한다.
CLAWOPS_MAX_RECORD_SECONDS=

# 시연 전용 — 발표자 번호를 등록된 대상자 번호로 바꿔 조회한다.
# 본인확인이 아니라 조회 키 치환일 뿐이고, 확정은 사회복지사가 한다.
# **둘 다 채워야 동작한다.** 비워두면 발표자 폰이 미등록으로 처리돼
# 이름 확인 질문이 아예 나오지 않는다 — 이것 때문에 하루를 헤맸다.
DEMO_CALLER_PHONE=
DEMO_CALLER_TARGET=010-1234-5678

# 우리 서비스의 공개 주소. 전화 콜백 주소를 만들 때 쓴다.
# 비우면 요청 헤더에서 유추하지만, 프록시 뒤에서는 직접 적는 편이 확실하다
# (헤더만 믿으면 http 로 만들어져 Cloudflare 가 301 을 태우고 본문이 날아간다).
PUBLIC_BASE_URL=https://donghaenggori.dohyeongops.com

# 인사말. 비우면 코드 기본값. 시연장에서 다듬을 수 있게 뺐다.
# 종료 방법 안내가 없으면 자동으로 붙는다.
CLAWOPS_GREETING=
# 녹음을 끝내는 키. 기본은 아무 키나. 빈 문자열이면 키 종료를 끈다.
CLAWOPS_FINISH_ON_KEY=1234567890*#
# 이름 확인 질문(1번/2번)을 할지. 0 이면 바로 문의만 받는다.
CLAWOPS_ASK_IDENTITY=1
