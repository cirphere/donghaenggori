# 백엔드(app) 설정 —  cp .env.app.example .env.app
# 이미 채운 파일에 다시 cp 하지 말 것 (키가 날아간다)
# 전부 없어도 동작한다. 없으면 규칙 기반·미연동으로 폴백.
#
# 주석은 반드시 키 **위 줄**에 쓴다. `KEY=   # 설명` 처럼 값 뒤에 붙이면,
# 값이 비어 있을 때 docker compose 가 그 주석을 값으로 읽는다.
# (HF_TOKEN 이 '# 모델 다운로드…' 가 되어 HTTP 헤더에서 터진 적이 있다)

# ── 공공데이터포털 (심평원·기상청·에어코리아 공용) ──────────────────
# 반드시 '일반 인증키(Decoding)'. Encoding 키가 아니다.
DATA_GO_KR_KEY=
# 심평원이 느리다(실측 8초). 짧으면 항상 타임아웃
PUBLIC_API_TIMEOUT=12.0
PUBLIC_API_CACHE_TTL=600

# ── Claude API (기본 꺼둠) ──────────────────────────────────────────
# 채우면 자동으로 켜지고, 어르신 발화가 외부로 나간다.
# 적용 여부는 기동 로그 "AI 배치 —" 줄에서 확인.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT=

# ── 음성인식 (로컬, 키 불필요) ──────────────────────────────────────
# GPU 오버레이를 쓰면 그쪽 값(medium/cuda)이 이긴다.
# base: vCPU 2개 기준. small 은 같은 장비에서 3배 느리다.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# 비우면 device 에 따라 정해진다 (cuda→float16, cpu→int8)
WHISPER_COMPUTE_TYPE=
WHISPER_CPU_THREADS=2
# 전사 확신도가 이보다 낮으면 접수에 '사람 확인 필요'
STT_CONF_THRESHOLD=-0.9
# 넘으면 413. 없으면 긴 파일 하나로 OOM
STT_MAX_SECONDS=300
# 모델 다운로드 속도 제한을 풀 때만. 없어도 받아진다
HF_TOKEN=

# ── 웹 ──────────────────────────────────────────────────────────────
# 비우면 전부 허용. 좁히려면 프론트 주소(쉼표로 여러 개)
CORS_ORIGINS=

# ── 전화 연동 (ClawOps) ─────────────────────────────────────────────
# ClawOps 대시보드의 Webhook Signing Secret. API Key 가 아니다.
# 비면 /api/voice/* 가 503 (전화 꺼짐).
CLAWOPS_SIGNING_KEY=
# 긴급 시 연결할 담당자 번호. 없으면 전환하지 않고 안내만 한다.
CLAWOPS_STAFF_NUMBER=

# 성함 녹음 상한(초). 비우면 20
CLAWOPS_IDENTITY_SECONDS=
# 문의 녹음 상한(초). 비우면 60.
# 적으면 코드 기본값을 덮어쓴다 — 기동 로그 "전화 설정 —" 줄로 확인.
CLAWOPS_MAX_RECORD_SECONDS=
# 비우면 코드 기본 인사말. 종료 방법 안내가 없으면 자동으로 붙는다.
CLAWOPS_GREETING=
CLAWOPS_FINISH_ON_KEY=1234567890*#
# 0 이면 이름 확인 질문(1번/2번) 없이 바로 문의를 받는다
CLAWOPS_ASK_IDENTITY=1

# 시연 전용 — 발표자 번호를 등록 대상자로 바꿔 조회한다(본인확인 아님).
# 둘 다 채워야 동작. 비우면 미등록으로 처리돼 이름 확인 질문이 안 나온다.
DEMO_CALLER_PHONE=
DEMO_CALLER_TARGET=010-1234-5678

# 전화 콜백 주소를 만들 때 쓴다. 프록시 뒤에서는 직접 적어야 확실하다.
PUBLIC_BASE_URL=https://donghaenggori.dohyeongops.com
