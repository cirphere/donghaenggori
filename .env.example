# ============================================================================
#  동행고리 AI — 환경변수 템플릿
# ============================================================================
#  사용법
#     cp .env.example .env      # 복사한 뒤 .env 에만 실제 값을 채웁니다
#
#  · .env 는 .gitignore 에 있어 커밋되지 않습니다.
#  · 키를 채팅·문서·슬랙에 붙여넣지 마세요.
#  · 아래 값은 전부 "없어도 동작"합니다. 없으면 규칙 기반·미연동으로 폴백합니다.
#    (발표 때 키 문제로 시연이 막히지 않게 한 설계입니다)
#
#  현재 상태 확인:  curl localhost:8000/api/status
# ============================================================================


# ─────────────────────────────────────────────────────────────────────
#  1. 공공데이터포털  (data.go.kr)
# ─────────────────────────────────────────────────────────────────────
#  계정당 인증키 1개로 아래 3개 API를 모두 사용합니다.
#  data.go.kr 로그인 → 각 API '활용신청' → 승인(1~3일) → 마이페이지에서 키 확인
#
#    · 건강보험심사평가원 병원정보서비스      → 병원 후보 보강, 진료과·진료시간
#    · 기상청 단기예보 조회서비스             → 외출 전 체크리스트(폭염·한파)
#    · 한국환경공단 에어코리아 대기오염정보    → 외출 전 체크리스트(미세먼지)
#
#  ※ 포털에서 주는 '일반 인증키(Decoding)'를 넣으세요.
#  없으면: 심평원·기상·대기 미연동. 병원 후보는 과거 동행 이력만으로 생성됩니다.
DATA_GO_KR_KEY=

# 외부 API 타임아웃(초).
#  심평원 API는 응답이 느립니다(실측 https 8초). 너무 짧으면 항상 타임아웃됩니다.
#  캐시가 있으므로 시연 중 재호출은 즉시 응답합니다.
PUBLIC_API_TIMEOUT=12.0
# 동일 요청 캐시 유지 시간(초). 시연 중 반복 호출로 쿼터를 쓰지 않게 합니다.
PUBLIC_API_CACHE_TTL=600


# ─────────────────────────────────────────────────────────────────────
#  2. Claude API  (선택)
# ─────────────────────────────────────────────────────────────────────
#  쓰이는 곳: ① 발화 의도·진료과 보강(nlu)  ② 사후기록 요약(summarize)
#  없으면: 규칙 사전 + 학습 분류기로 동작합니다. 사투리·모호 발화 품질만 떨어집니다.
#  console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 사용할 모델. 비우면 claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# 요약 LLM 호출 타임아웃(초). 비우면 20
ANTHROPIC_TIMEOUT=


# ─────────────────────────────────────────────────────────────────────
#  2-1. Cloudflare Tunnel  (선택 — 집 데스크탑을 외부에 공유할 때만)
# ─────────────────────────────────────────────────────────────────────
#  Zero Trust → Networks → Tunnels → Create a tunnel → Cloudflared 에서 토큰 복사.
#  Public Hostname 의 Service URL 은 반드시 http://app:8000 (localhost 아님).
#  없으면: 터널 오버레이를 안 쓰면 그만입니다. 로컬 실행에는 필요 없습니다.
CF_TUNNEL_TOKEN=


# ─────────────────────────────────────────────────────────────────────
#  3. STT (faster-whisper) — 로컬 추론, 키 불필요
# ─────────────────────────────────────────────────────────────────────
#  모델 크기: tiny | base | small | medium
#    실측(M5 맥북, 12.7초 음성): tiny 0.5s / base 0.7s / small 2.0s
#    셋 다 파이프라인 추출 정확도는 동일했습니다. 배포 시 base 권장.
WHISPER_MODEL=small

#  디바이스: cpu | cuda
#    · 맥(Apple Silicon)은 cpu만 가능 — CTranslate2에 Metal/MPS 백엔드가 없습니다.
#    · GPU 서버에 올릴 때만 cuda 로 바꾸세요.
WHISPER_DEVICE=cpu

#  연산 타입. 비우면 cpu=int8, cuda=float16 으로 자동 선택
WHISPER_COMPUTE_TYPE=

#  CPU 스레드 수. 0이면 라이브러리 기본값
WHISPER_CPU_THREADS=0

#  인식 확신도(평균 로그확률) 임계값. 이 값보다 낮으면 needs_review=true 로
#  표시해 사람 확인으로 넘깁니다. 0에 가까울수록 확신이 높습니다.
STT_CONF_THRESHOLD=-0.9

#  허용 음성 길이 상한(초). 넘으면 전사 전에 413으로 거절합니다.
#    메모리가 음성 길이에 비례해 늘어납니다 — 실측(small, 2스레드):
#    3.5초 1,170MB · 3분 1,774MB · 7.5분 2,221MB (분당 약 +140MB)
#    막지 않으면 4GiB 인스턴스는 15~20분짜리 파일 하나로 OOM 됩니다.
#    접수 발화는 수십 초, 매니저 메모도 2분 안쪽이라 5분이면 넉넉합니다.
STT_MAX_SECONDS=300


# ─────────────────────────────────────────────────────────────────────
#  4. Hugging Face  (선택)
# ─────────────────────────────────────────────────────────────────────
#  Whisper 모델 최초 다운로드 시 속도 제한을 피하려면 설정하세요.
#  없어도 받아집니다(익명 다운로드). huggingface.co/settings/tokens
HF_TOKEN=


# ─────────────────────────────────────────────────────────────────────
#  5. CORS (선택 — 프론트 연동)
# ─────────────────────────────────────────────────────────────────────
#  프론트는 별도 오리진(localhost:3000 등)에서 뜨므로 허용이 필요합니다.
#  비우면 전부 허용(*). 좁히려면 도메인을 콤마로 나열하세요.
#    예) CORS_ORIGINS=http://localhost:3000,https://myfront.example.com
CORS_ORIGINS=


# ─────────────────────────────────────────────────────────────────────
#  6. 프론트엔드 (선택 — docker-compose.frontend.yml 을 쓸 때만)
# ─────────────────────────────────────────────────────────────────────
#  빌드 산출물 디렉터리. Vite=dist(기본) / CRA=build / Next(export)=out
FRONTEND_BUILD_DIR=dist

# ── 전화 연동 (ClawOps VoiceML) ─────────────────────────────
# 대시보드 > Settings > Webhook 의 Signing Key. API Key 와 다른 값이다.
# 비어 있으면 /api/voice/* 가 503 을 돌려주고 전화 연동이 꺼진 상태가 된다.
CLAWOPS_SIGNING_KEY=
# 긴급 감지 시 연결할 담당자 번호. 없으면 전환하지 않고 안내만 한다.
CLAWOPS_STAFF_NUMBER=
# 녹음 최대 길이(초). 1턴·2턴 각각에 적용된다. 길수록 STT 대기가 길어져
# 어르신이 침묵을 견뎌야 한다. 코드 기본값과 같은 30 으로 둔다.
CLAWOPS_MAX_RECORD_SECONDS=30
# 시연 전용 — 발표자 번호를 등록된 대상자 번호로 바꿔 조회한다.
# 본인확인이 아니라 조회 키 치환일 뿐이고, 확정은 사회복지사가 한다.
# 둘 다 채워야 동작하며, 비워두면 일반 흐름을 그대로 탄다.
DEMO_CALLER_PHONE=
DEMO_CALLER_TARGET=010-1234-5678
# 우리 서비스의 공개 주소. 전화 2턴 콜백 주소를 만들 때 쓴다.
# 비워두면 요청 헤더에서 유추하지만, 프록시 뒤에서는 직접 적는 편이 확실하다.
PUBLIC_BASE_URL=https://donghaenggori.dohyeongops.com
# 인사말. 비우면 코드 기본값을 쓴다. 시연장에서 다듬을 수 있게 뺐다.
CLAWOPS_GREETING=
# 녹음을 끝내는 키. 기본은 아무 키나. 빈 문자열이면 키 종료를 끈다.
CLAWOPS_FINISH_ON_KEY=1234567890*#

# ── 화면 접근 제한 (nginx 기본 인증) ─────────────────────────
# 팀이 공유하는 아이디·비밀번호. 브라우저 로그인 창으로 들어간다.
# 비워두면 인증이 꺼지고 기동 로그에 경고가 남는다 — 주소를 아는 누구나
# 접수 목록을 보고 확정할 수 있게 되므로 반드시 채울 것.
# /api/voice/ (통신사 웹훅)와 /api/health 는 예외다.
STAFF_USER=
STAFF_PASSWORD=
# 통화 앞에서 "○○○ 님 맞으신가요? 1번/2번" 을 물을지. 0 이면 바로 증상을 받는다.
CLAWOPS_ASK_IDENTITY=1
