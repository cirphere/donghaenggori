# ============================================================================
#  동행고리 AI — 루트 .env  (docker compose 자체가 읽는 것만)
# ============================================================================
#     cp .env.example .env
#
#  이미 채운 파일에 다시 cp 하지 않는다 — 채워둔 값이 날아간다.
#
#  ── 컨테이너별 설정은 여기가 아니다 ──────────────────────────────────
#
#      .env.app.example       → .env.app        백엔드 (API 키·STT·전화)
#      .env.frontend.example  → .env.frontend   콘솔 로그인
#      .env.tunnel.example    → .env.tunnel     Cloudflare 터널 토큰
#
#  왜 나눴나: 터널 토큰 하나로 집 네트워크가 열리고, 콘솔 비밀번호로 어르신
#  정보가 열린다. 성격이 다른 비밀을 한 파일에 두면 팀원에게 하나를 공유할 때
#  나머지까지 같이 넘어간다.
#
#  ── 여기 남은 것은 compose 가 ${} 치환에 쓰는 값뿐이다 ──────────────
#
#  compose 는 ${VAR} 치환에 **루트 .env 만** 읽는다. env_file 로 넣은 값은
#  치환에 쓰이지 않는다. 그래서 아래 두 개만 여기 남는다.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────
#  띄울 구성 — 적어두면 -f 없이 `docker compose up -d` 로 끝난다
# ─────────────────────────────────────────────────────────────────────
#  기본(백엔드만):     비워둔다
#  프론트까지:         docker-compose.yml:docker-compose.frontend.yml
#  데스크탑 GPU 전체:  docker-compose.yml:docker-compose.gpu.yml:docker-compose.frontend.yml:docker-compose.tunnel.yml
COMPOSE_FILE=

# 프론트 빌드 산출물 디렉터리 — Vite=dist, CRA=build, Next(export)=out.
# 지금 프론트는 빌드 없이 정적 파일이라 건드릴 일이 없다.
FRONTEND_BUILD_DIR=dist
