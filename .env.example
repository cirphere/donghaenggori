# ============================================================================
#  동행고리 AI — 환경변수 템플릿
# ============================================================================
#  사용법
#     cp .env.example .env      # 복사한 뒤 .env 에만 실제 값을 채웁니다
#
#  · .env 는 .gitignore 에 있어 커밋되지 않습니다.
#  · 키를 채팅·문서·슬랙에 붙여넣지 마세요.
#  · 아래 값은 전부 "없어도 동작"합니다. 없으면 규칙 기반·미연동으로 폴백합니다.
#    (발표 때 키 문제로 시연이 막히지 않게 한 설계입니다)
#
#  현재 상태 확인:  curl localhost:8000/api/status
# ============================================================================


# ─────────────────────────────────────────────────────────────────────
#  1. 공공데이터포털  (data.go.kr)
# ─────────────────────────────────────────────────────────────────────
#  계정당 인증키 1개로 아래 3개 API를 모두 사용합니다.
#  data.go.kr 로그인 → 각 API '활용신청' → 승인(1~3일) → 마이페이지에서 키 확인
#
#    · 건강보험심사평가원 병원정보서비스      → 병원 후보 보강, 진료과·진료시간
#    · 기상청 단기예보 조회서비스             → 외출 전 체크리스트(폭염·한파)
#    · 한국환경공단 에어코리아 대기오염정보    → 외출 전 체크리스트(미세먼지)
#
#  ※ 포털에서 주는 '일반 인증키(Decoding)'를 넣으세요.
#  없으면: 심평원·기상·대기 미연동. 병원 후보는 과거 동행 이력만으로 생성됩니다.
DATA_GO_KR_KEY=

# 외부 API 타임아웃(초).
#  심평원 API는 응답이 느립니다(실측 https 8초). 너무 짧으면 항상 타임아웃됩니다.
#  캐시가 있으므로 시연 중 재호출은 즉시 응답합니다.
PUBLIC_API_TIMEOUT=12.0
# 동일 요청 캐시 유지 시간(초). 시연 중 반복 호출로 쿼터를 쓰지 않게 합니다.
PUBLIC_API_CACHE_TTL=600


# ─────────────────────────────────────────────────────────────────────
#  2. Claude API  (선택)
# ─────────────────────────────────────────────────────────────────────
#  쓰이는 곳: ① 발화 의도·진료과 보강(nlu)  ② 사후기록 요약(summarize)
#  없으면: 규칙 사전 + 학습 분류기로 동작합니다. 사투리·모호 발화 품질만 떨어집니다.
#  console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 사용할 모델. 비우면 claude-opus-5
ANTHROPIC_MODEL=claude-opus-5

# 요약 LLM 호출 타임아웃(초). 비우면 20
ANTHROPIC_TIMEOUT=


# ─────────────────────────────────────────────────────────────────────
#  3. STT (faster-whisper) — 로컬 추론, 키 불필요
# ─────────────────────────────────────────────────────────────────────
#  모델 크기: tiny | base | small | medium
#    실측(M5 맥북, 12.7초 음성): tiny 0.5s / base 0.7s / small 2.0s
#    셋 다 파이프라인 추출 정확도는 동일했습니다. 배포 시 base 권장.
WHISPER_MODEL=small

#  디바이스: cpu | cuda
#    · 맥(Apple Silicon)은 cpu만 가능 — CTranslate2에 Metal/MPS 백엔드가 없습니다.
#    · GPU 서버에 올릴 때만 cuda 로 바꾸세요.
WHISPER_DEVICE=cpu

#  연산 타입. 비우면 cpu=int8, cuda=float16 으로 자동 선택
WHISPER_COMPUTE_TYPE=

#  CPU 스레드 수. 0이면 라이브러리 기본값
WHISPER_CPU_THREADS=0

#  인식 확신도(평균 로그확률) 임계값. 이 값보다 낮으면 needs_review=true 로
#  표시해 사람 확인으로 넘깁니다. 0에 가까울수록 확신이 높습니다.
STT_CONF_THRESHOLD=-0.9


# ─────────────────────────────────────────────────────────────────────
#  4. Hugging Face  (선택)
# ─────────────────────────────────────────────────────────────────────
#  Whisper 모델 최초 다운로드 시 속도 제한을 피하려면 설정하세요.
#  없어도 받아집니다(익명 다운로드). huggingface.co/settings/tokens
HF_TOKEN=
