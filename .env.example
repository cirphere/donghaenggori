# docker compose 자체가 읽는 값만 둔다.
# 컨테이너 설정은 .env.app / .env.frontend / .env.tunnel 에 있다.

# 띄울 구성. 적어두면 -f 없이 `docker compose up -d` 로 끝난다.
# 지우면 app 하나만 뜬다 — 프론트·터널이 조용히 사라진다.
#   백엔드만:          비워둔다
#   프론트까지:        docker-compose.yml:docker-compose.frontend.yml
#   Next 콘솔까지:      docker-compose.yml:docker-compose.frontend.yml:docker-compose.next.yml
#   데스크탑 GPU 전체: docker-compose.yml:docker-compose.gpu.yml:docker-compose.frontend.yml:docker-compose.next.yml:docker-compose.tunnel.yml
#
# dev 오버레이(docker-compose.dev.yml)를 **맨 뒤에** 붙이면 소스를 호스트에서
# 읽어서, 코드 변경에 재빌드가 필요 없어진다(git pull → restart 로 끝).
# GPU 이미지는 재빌드 한 번이 7분이라 데스크탑에서는 붙여 두는 편이 낫다.
#   …:docker-compose.tunnel.yml:docker-compose.dev.yml
COMPOSE_FILE=

# 프론트 빌드 산출물 디렉터리(Vite=dist, CRA=build). 지금은 빌드가 없다.
FRONTEND_BUILD_DIR=dist
