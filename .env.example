# 루트 .env —  cp .env.example .env
# docker compose 자체가 읽는 값만 둔다. 컨테이너 설정은 아래 파일들에 있다:
#     .env.app.example       → .env.app        백엔드 (API 키·STT·전화)
#     .env.frontend.example  → .env.frontend   콘솔 로그인
#     .env.tunnel.example    → .env.tunnel     터널 토큰
#
# compose 는 ${} 치환에 루트 .env 만 읽는다. 그래서 아래 둘은 옮길 수 없다.
#
# ⚠️ 이 파일을 지우지 말 것. COMPOSE_FILE 이 없으면 app 하나만 뜬다
#    (에러 없이 프론트·터널이 사라진다). tests/preflight.py 가 이걸 잡는다.

# 띄울 구성. 적어두면 -f 없이 `docker compose up -d` 로 끝난다.
#   백엔드만:          비워둔다
#   프론트까지:        docker-compose.yml:docker-compose.frontend.yml
#   데스크탑 GPU 전체: docker-compose.yml:docker-compose.gpu.yml:docker-compose.frontend.yml:docker-compose.tunnel.yml
COMPOSE_FILE=

# 프론트 빌드 산출물 디렉터리(Vite=dist, CRA=build). 지금은 빌드가 없어 건드릴 일 없다.
FRONTEND_BUILD_DIR=dist
