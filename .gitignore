# 비밀 — API 키 절대 커밋 금지
.env
# 컨테이너별 설정. .example 만 저장소에 둔다 — 실제 값은 각자 채운다.
.env.*
!.env.example
!.env.*.example
*.key

# 가상환경
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 런타임 생성물 (시드에서 재생성됨)
donghaenggori/data/*.db
donghaenggori/data/*.sqlite3

# macOS
.DS_Store

# 문서·발표자료는 이 저장소에 포함하지 않는다 (코드 전용)
*.docx
*.xlsx
*.pptx
*.hwp
*.hwpx

# 학습 산출물 — train_intent.py 로 재생성
donghaenggori/data/models/
